+static int mov_read_dstr(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    if (!c || !c->fc) {
+        av_log(NULL, AV_LOG_ERROR, "Invalid context for DSTR box\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    // Read version/flags (int32)
+    avio_rb32(pb);
+    int64_t bytes_read = 4;
+
+    // Read distortion model string
+    char distortion_model[256];
+    int ret = avio_get_str(pb, sizeof(distortion_model), distortion_model, sizeof(distortion_model));
+    if (ret < 0) {
+        return ret;
+    }
+    bytes_read += strlen(distortion_model) + 1; // +1 for null terminator
+
+    // Read camera model string
+    char camera_model[256];
+    ret = avio_get_str(pb, sizeof(camera_model), camera_model, sizeof(camera_model));
+    if (ret < 0) {
+        return ret;
+    }
+    bytes_read += strlen(camera_model) + 1; // +1 for null terminator
+    av_log(c->fc, AV_LOG_INFO, "DSTR box: distortion_model=%s, camera_model=%s\n", distortion_model, camera_model);
+
+    // Per-camera coefficient count for the declared distortion model.
+    int per_cam_coeff;
+    if (strcmp(distortion_model, "equidistant") == 0) {
+        per_cam_coeff = 4;
+    } else if (strcmp(distortion_model, "brown") == 0) {
+        per_cam_coeff = 5;
+    } else if (strcmp(distortion_model, "equiDis62") == 0) {
+        per_cam_coeff = 8;
+    } else {
+        av_log(c->fc, AV_LOG_ERROR, "DSTR box: unknown distortion model: %s\n", distortion_model);
+        return AVERROR_INVALIDDATA;
+    }
+    // Derive the number of coefficient sets from the actual box payload rather
+    // than assuming two cameras. A mono capture writes a single set; reading a
+    // hard-coded two sets over-runs the box into the following bytes, yielding
+    // a garbage distortion_params_1. The DSTR payload after the version field
+    // and the two model strings is exactly (num_cameras * per_cam_coeff)
+    // little-endian doubles.
+    int64_t coeff_bytes = atom.size - bytes_read;
+    int64_t per_cam_bytes = (int64_t)per_cam_coeff * (int64_t)sizeof(double);
+    if (coeff_bytes < per_cam_bytes) {
+        av_log(c->fc, AV_LOG_ERROR, "DSTR box: payload %"PRId64" bytes too small for model %s\n",
+               coeff_bytes, distortion_model);
+        return AVERROR_INVALIDDATA;
+    }
+    int64_t dist_coeff_size = coeff_bytes / (int64_t)sizeof(double);
+    dist_coeff_size -= dist_coeff_size % per_cam_coeff; // whole sets only
+    int64_t num_sets = dist_coeff_size / per_cam_coeff;
+    char *value_str_left = av_malloc(dist_coeff_size * 32); // each double has at most 32 characters
+    if (!value_str_left) {
+        return AVERROR(ENOMEM);
+    }
+    value_str_left[0] = '\0';
+    char *value_str_right = av_malloc(dist_coeff_size * 32);
+    if (!value_str_right) {
+        av_freep(&value_str_left);
+        return AVERROR(ENOMEM);
+    }
+    value_str_right[0] = '\0';
+    int64_t remaining_data_size = sizeof(double) * dist_coeff_size;
+    double *additional_data = NULL;
+    if (remaining_data_size > 0) {
+        additional_data = av_malloc(remaining_data_size);
+        if (!additional_data) {
+            av_freep(&value_str_left);
+            av_freep(&value_str_right);
+            return AVERROR(ENOMEM);
+        }
+        ret = avio_read(pb, (uint8_t*)additional_data, remaining_data_size);
+        if (ret != remaining_data_size) {
+            av_freep(&value_str_left);
+            av_freep(&value_str_right);
+            av_freep(&additional_data);
+            return AVERROR_INVALIDDATA;
+        }
+        // av_log(c->fc, AV_LOG_INFO, "DSTR box: additional_data=%f, %f, %f, %f\n", additional_data[0], additional_data[1], additional_data[2], additional_data[3]);
+
+    }
+    // First per_cam_coeff doubles are camera 0, the next set (if present) is
+    // camera 1. Split on per_cam_coeff, not dist_coeff_size / 2, so a single
+    // camera's coefficients are not chopped across the left/right buffers.
+    for (int i = 0; i < dist_coeff_size; i++) {
+        char temp[32];
+        snprintf(temp, sizeof(temp), "%f,", additional_data[i]);
+        if (i < per_cam_coeff) {
+            strcat(value_str_left, temp);
+        } else if (i < 2 * per_cam_coeff) {
+            strcat(value_str_right, temp);
+        }
+    }
+    if (strlen(value_str_left) > 0) {
+        value_str_left[strlen(value_str_left) - 1] = '\0';
+    }
+    if (strlen(value_str_right) > 0) {
+        value_str_right[strlen(value_str_right) - 1] = '\0';
+    }
+    av_log(c->fc, AV_LOG_DEBUG, "DSTR box: sets=%"PRId64" %s, %s\n", num_sets, value_str_left, value_str_right);
+
+    AVStream *st = c->fc->streams[c->fc->nb_streams-1];
+
+    // Store individual components in metadata
+    av_dict_set(&st->metadata, "camera_model", camera_model, 0);
+    av_dict_set(&st->metadata, "distortion_model", distortion_model, 0);
+    av_dict_set(&st->metadata, "distortion_params_0", value_str_left, 0);
+    // Only expose distortion_params_1 when the payload actually carried a
+    // second camera's coefficients (and never for the single-camera depth
+    // track, codec_id == 0).
+    if (num_sets >= 2 && st->codecpar->codec_id != 0) {
+        av_dict_set(&st->metadata, "distortion_params_1", value_str_right, 0);
+    }
+
+    av_freep(&value_str_left);
+    av_freep(&value_str_right);
+    av_freep(&additional_data);
+    return 0;
+}
+
+static int mov_read_tbtm(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    if (!c || !c->fc) {
+        av_log(NULL, AV_LOG_ERROR, "Invalid context for TBTM box\n");
+        return AVERROR_INVALIDDATA;
+    }
+    uint64_t timebase = avio_rb64(pb);
+    // av_log(c->fc, AV_LOG_INFO, "TBTM box: timebase=%lld\n", timebase);
+    AVStream *st = c->fc->streams[c->fc->nb_streams-1];
+    char timebase_str[32];
+    snprintf(timebase_str, sizeof(timebase_str), "%ld", timebase);
+    av_dict_set(&st->metadata, "timebase", timebase_str, 0);
+    return 0;
+}
+
+// Paired with mov_write_tbgt_tag: surfaces the writer's track_base_godot_ticks_us
+// (== first_pts_us_writer_) anchor as a stream-metadata tag of the same name.
+// Downstream tools that previously needed android_timebase.json's
+// session_start_godot_ticks_us anchor can now read this single tag from any
+// stream (RGB, depth, or any mett track) and reconstruct absolute Godot-
+// ticks-ns timestamps without any sidecar file.
+static int mov_read_tbgt(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    if (!c || !c->fc) {
+        av_log(NULL, AV_LOG_ERROR, "Invalid context for TBGT box\n");
+        return AVERROR_INVALIDDATA;
+    }
+    uint64_t godot_ticks_us = avio_rb64(pb);
+    AVStream *st = c->fc->streams[c->fc->nb_streams-1];
+    char buf[32];
+    snprintf(buf, sizeof(buf), "%ld", godot_ticks_us);
+    av_dict_set(&st->metadata, "track_base_godot_ticks_us", buf, 0);
+    return 0;
+}
