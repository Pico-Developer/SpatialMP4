+static int mov_read_ecam(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    if (!c || !c->fc) {
+        av_log(NULL, AV_LOG_ERROR, "Invalid context for ECAM box\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    avio_rb32(pb);  // writeInt32(0)
